VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Cloudflare Turnstile site key. For local development you can use Cloudflare's
# public test key below, which always passes and needs no Cloudflare account:
#   VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA
# Use a real key from your own Turnstile widget before deploying.
VITE_TURNSTILE_SITE_KEY=

# Address shown in the privacy policy for data access, correction and deletion
# requests. Falls back to a visible placeholder when unset.
VITE_CONTACT_EMAIL=
# Supabase automatically injects these into Edge Functions at runtime.
# You do not need to set these manually — they are provided by the Supabase platform.
# SUPABASE_URL=           (auto-injected)
# SUPABASE_ANON_KEY=      (auto-injected)
# SUPABASE_SERVICE_ROLE_KEY= (auto-injected)

# Optional production-only Sentry browser DSN.
# Create a free Sentry JavaScript/React project, copy the client DSN,
# and set this in Vercel Production/Preview environment variables.
VITE_SENTRY_DSN=

# Supabase Edge Function secrets, set with `supabase secrets set`
# Turnstile's matching test secret for local development is
# 1x0000000000000000000000000000000AA (pairs with the test site key above).
TURNSTILE_SECRET_KEY=
RATE_LIMIT_SALT=

# Public site origin used to build absolute links (booking deep links, reset
# redirects) inside Edge Functions, and the CORS fallback when ALLOWED_ORIGINS
# is unset. Required in production.
SITE_URL=

# Comma-separated origins allowed to call the public Edge Functions. Include the
# apex and www forms of your domain. Add local dev origins only to your local
# functions env, never to the production secret. If unset, SITE_URL is used; if
# both are unset every request is rejected.
# Example: https://example.com,https://www.example.com
ALLOWED_ORIGINS=

# Shared secret the warmup cron sends (x-warmup-secret) so pings skip real work.
WARMUP_SECRET=

# Telegram outbound bot (C1 admin notifications + C2 weekly band-chat board).
# Outbound-only: no inbound webhook. Bot token from BotFather; chat/thread ids
# from the target chats; trigger secret is Vault-stored and compared by the
# telegram-weekly function. Never commit real values.
TELEGRAM_BOT_TOKEN=
TELEGRAM_TRIGGER_SECRET=
TELEGRAM_ADMIN_CHAT_ID=
TELEGRAM_ADMIN_THREAD_ID=
TELEGRAM_BOARD_CHAT_ID=
TELEGRAM_BOARD_THREAD_ID=
# "edit" (default: self-healing single pinned message) or "announce" (new post).
TELEGRAM_BOARD_MODE=edit
